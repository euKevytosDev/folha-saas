# Perfil da aplicação: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
# Local Docker Compose: jdbc:postgresql://localhost:5433/folha
# Neon (Render): cole a connection string UNPOOLED do console (postgresql://...sslmode=require).
# O Docker entrypoint converte postgres(ql):// → jdbc:postgresql:// automaticamente.
DATABASE_URL=jdbc:postgresql://localhost:5433/folha
DATABASE_USERNAME=folha
DATABASE_PASSWORD=folha

# CORS — origens permitidas, separadas por vírgula
# Inclua a URL do GitHub Pages quando o frontend estiver separado do backend.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# JWT (usado a partir da FASE 2)
# Gere um valor longo e aleatório (mínimo 32 bytes). Nunca commite o valor real.
JWT_SECRET=change-me-generate-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
PASSWORD_RESET_EXPIRATION_MS=3600000
COOKIE_SECURE=false

# SUPER_ADMIN opcional no perfil dev (deixe vazio para não criar)
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Diretório do frontend em desenvolvimento (live reload de HTML/CSS/JS sem rebuild)
# Em produção, deixe vazio para servir os arquivos empacotados no JAR.
FRONTEND_DIR=

# Pagamentos / webhooks
# Em prod (SPRING_PROFILES_ACTIVE=prod) simulate e mock webhooks já vêm desligados.
PAYMENTS_SIMULATE_ENABLED=true
PAYMENTS_MOCK_WEBHOOKS_ENABLED=true
PAYMENTS_REQUIRE_WEBHOOK_SECRET=false
PAYMENTS_MOCK_WEBHOOK_SECRET=folha-dev-webhook-secret

# Rate limit básico de auth (por IP+email). Em prod o default é ~20 login / 5 min.
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300

# Cloudinary (upload de fotos de produto, logo e capa)
# Dashboard → Settings → API Keys. Sem isso, o admin continua aceitando só URL.
# Pode usar as 3 variáveis abaixo OU só CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=folha
CLOUDINARY_MAX_BYTES=5242880
